GROQ_API_KEY=

# Optional override. The app defaults to a working Groq model in 2026.
# GROQ_MODEL=qwen/qwen3.8-27b

# Optional Android backend URL. Leave empty for web development (Vite proxies /api).
# Use an HTTPS URL for a hosted backend; phone access must be reachable from the device.
# VITE_API_BASE_URL=https://api.example.com

# Optional API binding and cross-origin app origins when testing on a device.
# HOST=0.0.0.0
# CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost
# Set COOKIE_SECURE=true only when the API is served over HTTPS.
# COOKIE_SECURE=true
